{
  "version": "1.3.0",
  "status": "observed_structure_only",
  "format": "xlsx",
  "sheet_policy": "exactly_one_worksheet",
  "unknown_layout_policy": "quarantine",
  "formula_policy": "reject_in_mapped_fields",
  "missing_metric_policy": {
    "blank_value": null,
    "blank_status": "source_blank",
    "literal_status": "reported",
    "unverified_sentinel": "quarantine"
  },
  "processing_spec": "../common.md",
  "method_id": "group_item_analysis",
  "grain": "population_question_alignment_row",
  "detection": {
    "required_headers": [
      "Total Students",
      "Question Number",
      "Learning Standard Number",
      "Student Correct"
    ],
    "optional_headers": [],
    "observed_header_rows": 2,
    "header_normalization": "trim_collapse_whitespace_preserve_case",
    "duplicate_headers": "quarantine",
    "unknown_populated_columns": "quarantine"
  },
  "fields": [
    {
      "source": "Total Students",
      "target": "group_item_results.reported_total_students",
      "value_type": "integer",
      "required": true,
      "privacy": "private",
      "unit": "students_denominator_unverified",
      "observed_formats": [
        "General"
      ],
      "notes": "Repeated per question; never sum; exact denominator unknown."
    },
    {
      "source": "Question Number",
      "target": "items.question_label",
      "value_type": "integer",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "assessment_local_label",
      "observed_formats": [
        "General"
      ],
      "notes": "Positive whole numeric label in this variant; convert losslessly to text."
    },
    {
      "source": "Learning Standard Number",
      "target": "item_standards.standard_code",
      "value_type": "text",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "standard_code",
      "observed_formats": [
        "General"
      ],
      "notes": "Normalize with the shared TEKS policy; retain grade and all suffixes, with original source spelling privately preserved."
    },
    {
      "source": "Student Correct",
      "target": "group_item_results.reported_correct_ratio",
      "value_type": "ratio",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "ratio_0_1",
      "observed_formats": [
        "0.00%"
      ],
      "notes": "Percentage, not count; numerator/denominator and partial credit unknown."
    }
  ],
  "dynamic_axis": {
    "kind": "question_rows",
    "container_header": "Question Number",
    "pattern_dialect": "python_re",
    "canonical_rule": "Shared subject-scoped TEKS normalization with K, numeric-grade or explicitly registered course prefix; optional R/S tags retained privately",
    "count_policy": "discover_rows_inside_single_group_merge",
    "duplicate_key_policy": "quarantine",
    "standard_label_pattern": "^(?P<level>(?:[0-9]+|[A-Za-z][A-Za-z0-9_-]{0,31}))\\.(?P<number>[0-9]+)(?:\\((?P<expectation>[A-Za-z])(?P<suffix>(?:\\.[A-Za-z0-9]+)*)\\)|\\.?(?P<plain>[A-Za-z](?:\\.[A-Za-z0-9]+)*))(?: \\[(?P<tag>[RSrs])\\])?$"
  },
  "export_tables": {
    "group_item_results": [
      "assessment_key",
      "population_key",
      "snapshot_key",
      "question_label",
      "standard_code",
      "reported_correct_ratio",
      "result_status",
      "provenance_ref",
      "standards_scope_key"
    ]
  },
  "observation_ids": [
    "itemperc-2025-g5",
    "itemperc-2026-g6"
  ],
  "blocking_unknowns": [
    "Correctness numerator and population/partial-credit denominators unknown.",
    "Multi-group and multi-alignment variants not verified.",
    "Varying Total Students values require source semantics review.",
    "Population equivalence across methods and time must be established privately."
  ],
  "implementation": {
    "adapter_version": "0.3.0",
    "verification": "synthetic_xlsx_only",
    "agent_format": "datagoblin.agent.v1"
  },
  "standards_policy": "../standards.json"
}
