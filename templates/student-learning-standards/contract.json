  "observation_ids": [
    "slsb-2025-g5",
    "slsb-2026-g6"
  ],
  "blocking_unknowns": [
    "Flag token meanings must be verified before exporting or tabulating flags.",
    "Exact numerator/denominator and partial-credit rules are unknown; do not compute pooled rates.",
    "No observed actual attempt ID; duplicate student keys require resolution.",
    "Identity boundary and alias map must exist before processing student rows."
  ],
  "implementation": {
    "adapter_version": "0.3.0",
