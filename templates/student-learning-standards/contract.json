      "target": "private_identity_context.display_name",
      "value_type": "text",
      "required": true,
      "privacy": "private",
      "unit": "none",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Never match or alias by name alone."
    },
    {
      "source": "Local ID",
      "target": "private_identity_map.local_id",
      "value_type": "text",
      "required": true,
      "privacy": "private",
      "unit": "opaque_identifier",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Namespace-scoped text; preserve leading zeros; numeric IDs require review."
    },
    {
      "source": "Special Ed Indicator",
      "target": "private_attributes.special_ed",
      "value_type": "text",
      "required": false,
      "privacy": "private",
      "unit": "unverified",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Observed in both files; absent-column variant and value vocabulary not verified."
    },
    {
      "source": "Emergent Bilingual",
      "target": "private_attributes.emergent_bilingual",
      "value_type": "text",
      "required": false,
      "privacy": "private",
      "unit": "unverified",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Observed in both files; absent-column variant and value vocabulary not verified."
    },
    {
      "source": "Ethnicity",
      "target": "private_attributes.ethnicity",
      "value_type": "text",
      "required": false,
      "privacy": "private",
      "unit": "unverified",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Observed in both files; absent-column variant and value vocabulary not verified."
    },
    {
      "source": "All Learning Standards",
      "target": "student_standard_results.reported_ratio",
      "value_type": "ratio",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "ratio_0_1",
      "observed_formats": [
        "0%"
      ],
      "notes": "Container header. Each child standard header yields one result per student; denominator unknown."
    },
    {
      "source": "Raw Score",
      "target": "attempt_summaries.reported_raw_score",
      "value_type": "number",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "unverified",
      "observed_formats": [
        "General"
      ],
      "notes": "Preserve reported measure; maximum and weighting unknown."
    },
    {
      "source": "Scale Score",
      "target": "attempt_summaries.reported_scale_score",
      "value_type": "number",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "unverified",
      "observed_formats": [
        "General"
      ],
      "notes": "Preserve reported measure; cross-grade comparability unknown."
    },
    {
      "source": "Percent Score",
      "target": "attempt_summaries.reported_percent_ratio",
      "value_type": "ratio",
      "required": true,
      "privacy": "allowlist_requires_review",
      "unit": "ratio_0_1",
      "observed_formats": [
        "0.00%"
