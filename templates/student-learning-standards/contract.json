{
  "version": "1.3.0",
  "status": "observed_structure_only",
  "format": "xlsx",
  "sheet_policy": "exactly_one_worksheet",
  "unknown_layout_policy": "quarantine",
  "formula_policy": "reject_in_mapped_fields",
  "missing_metric_policy": {
    "blank_value": null,
    "blank_status": "source_blank",
    "literal_status": "reported",
    "unverified_sentinel": "quarantine"
  },
  "processing_spec": "../common.md",
  "method_id": "student_learning_standards",
  "grain": "student_report_row_with_standard_aggregates",
  "detection": {
    "required_headers": [
      "Student Name",
      "Local ID",
      "All Learning Standards",
      "Raw Score",
      "Scale Score",
      "Percent Score",
      "Approaches Grade Level (TX)",
      "Meets Grade Level (TX)",
      "Masters Grade Level (TX)"
    ],
    "optional_headers": [
      "Special Ed Indicator",
      "Emergent Bilingual",
      "Ethnicity"
    ],
    "observed_header_rows": 3,
    "header_normalization": "trim_collapse_whitespace_preserve_case",
    "duplicate_headers": "quarantine",
    "unknown_populated_columns": "quarantine"
  },
  "fields": [
