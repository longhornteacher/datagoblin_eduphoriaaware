      "privacy": "allowlist_requires_review",
      "unit": "unverified",
      "observed_formats": [
        "\"text\""
      ],
      "notes": "Retain raw text privately; export typed flags only after vocabulary verification."
    }
  ],
  "dynamic_axis": {
    "kind": "standard_columns",
    "container_header": "All Learning Standards",
    "pattern_dialect": "python_re",
    "canonical_rule": "Shared subject-scoped TEKS normalization with K, numeric-grade or explicitly registered course prefix; optional R/S tags retained privately",
    "count_policy": "discover_from_actual_container_merge",
    "duplicate_key_policy": "quarantine",
    "standard_label_pattern": "^(?P<level>(?:[0-9]+|[A-Za-z][A-Za-z0-9_-]{0,31}))\\.(?P<number>[0-9]+)(?:\\((?P<expectation>[A-Za-z])(?P<suffix>(?:\\.[A-Za-z0-9]+)*)\\)|\\.?(?P<plain>[A-Za-z](?:\\.[A-Za-z0-9]+)*))(?: \\[(?P<tag>[RSrs])\\])?$"
  },
  "export_tables": {
